# Copier ce fichier en .env.local puis adapter les valeurs.

# URL publique du site (URL canoniques, Open Graph, données structurées).
# Adresse GitHub Pages actuelle ; à remplacer si le site passe sur un nom de domaine.
VITE_SITE_URL=https://delfaha.github.io/farhandel-agency

# URL de l'API backend (recherche de vols, réservations, authentification…).
# Laisser vide tant que le backend n'existe pas.
VITE_API_URL=

# true (défaut) : données de démonstration locales ; false : appels HTTP vers VITE_API_URL.
VITE_USE_MOCKS=true
